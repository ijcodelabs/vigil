# Build output
/bin/
/dist/
*.test
*.out
coverage.*

# Runtime data: the server's database, stored captures, agent spools
/data/
*.db
*.db-*
/spool/
*.log

# Secrets and local settings. Real tokens belong in the environment or in
# these files, never in the example configs.
.env
.env.*
*.env
!*.env.example
/configs/*.local.yaml
*.pem
*.key
*.crt

# Editors and operating system
.DS_Store
.idea/
.vscode/
*.swp
*~

# Claude Code: personal settings and worktrees stay local
.claude/settings.local.json
.claude/worktrees/

# NOT ignored on purpose: internal/events/events_*_bpfel.o
# They are the compiled kernel probes. They are generated by `make bpf` and
# committed so that building vigil needs only Go.
