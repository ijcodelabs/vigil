{
 "id": "containers",
 "title": "Containers",
 "variables": [
  {
   "name": "agent",
   "label": "agent",
   "match": "container_memory_usage_bytes"
  }
 ],
 "panels": [
  {
   "title": "Containers running",
   "type": "stat",
   "w": 3,
   "h": 2,
   "unit": "",
   "queries": [
    {
     "expr": "count(container_memory_usage_bytes{agent=~\"$agent\"})"
    }
   ]
  },
  {
   "title": "Memory in use",
   "type": "stat",
   "w": 3,
   "h": 2,
   "unit": "bytes",
   "queries": [
    {
     "expr": "sum(container_memory_usage_bytes{agent=~\"$agent\"})"
    }
   ]
  },
  {
   "title": "CPU cores in use",
   "type": "stat",
   "w": 3,
   "h": 2,
   "unit": "cores",
   "queries": [
    {
     "expr": "sum(rate(container_cpu_usage_seconds_total{agent=~\"$agent\"}[2m]))"
    }
   ]
  },
  {
   "title": "Busiest container, CPU",
   "type": "stat",
   "w": 3,
   "h": 2,
   "unit": "cores",
   "queries": [
    {
     "expr": "max(rate(container_cpu_usage_seconds_total{agent=~\"$agent\"}[2m]))"
    }
   ]
  },
  {
   "title": "Containers that are not running",
   "type": "table",
   "w": 12,
   "h": 2,
   "unit": "",
   "columns": [
    "container",
    "image",
    "agent"
   ],
   "queries": [
    {
     "expr": "sort_by_label(container_exit_code{agent=~\"$agent\"} and container_running == 0, \"agent\", \"container\")",
     "legend": "Exit code (0: finished)",
     "warn": 1,
     "crit": 1
    },
    {
     "expr": "(time() - tlast_change_over_time(container_running{agent=~\"$agent\"}[30d])) and container_running == 0",
     "legend": "Stopped for",
     "unit": "seconds"
    },
    {
     "expr": "container_restarts_total{agent=~\"$agent\"} and container_running == 0",
     "legend": "Restarts"
    }
   ]
  },
  {
   "title": "CPU by container",
   "type": "timeseries",
   "w": 6,
   "h": 3,
   "unit": "cores",
   "queries": [
    {
     "expr": "rate(container_cpu_usage_seconds_total{agent=~\"$agent\"}[2m])",
     "legend": "{{container}}"
    }
   ],
   "min": 0,
   "fill": true
  },
  {
   "title": "Memory by container",
   "type": "timeseries",
   "w": 6,
   "h": 3,
   "unit": "bytes",
   "queries": [
    {
     "expr": "container_memory_usage_bytes{agent=~\"$agent\"}",
     "legend": "{{container}}"
    }
   ],
   "min": 0
  },
  {
   "title": "Network received",
   "type": "timeseries",
   "w": 6,
   "h": 3,
   "unit": "bytes/s",
   "queries": [
    {
     "expr": "sum by (container) (rate(container_network_receive_bytes_total{agent=~\"$agent\"}[2m]))",
     "legend": "{{container}}"
    }
   ],
   "min": 0
  },
  {
   "title": "Network sent",
   "type": "timeseries",
   "w": 6,
   "h": 3,
   "unit": "bytes/s",
   "queries": [
    {
     "expr": "sum by (container) (rate(container_network_transmit_bytes_total{agent=~\"$agent\"}[2m]))",
     "legend": "{{container}}"
    }
   ],
   "min": 0
  },
  {
   "title": "Memory now",
   "type": "table",
   "w": 12,
   "h": 3,
   "unit": "bytes",
   "queries": [
    {
     "expr": "sort_desc(container_memory_usage_bytes{agent=~\"$agent\"})"
    }
   ]
  }
 ]
}
