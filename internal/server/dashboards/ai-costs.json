{
  "id": "ai-costs",
  "title": "AI costs",
  "variables": [
    {
      "name": "service",
      "label": "service",
      "match": "genai_tokens_total"
    }
  ],
  "panels": [
    {
      "title": "All AI: billed in the shown time",
      "type": "stat",
      "w": 3,
      "h": 2,
      "unit": "",
      "queries": [
        {
          "expr": "sum(sum_over_time(ai_cost_usd_per_minute{billing!=\"subscription\"}[$__range])) or vector(0)"
        }
      ]
    },
    {
      "title": "Billed per day, at this hour's rate",
      "type": "stat",
      "w": 3,
      "h": 2,
      "unit": "",
      "queries": [
        {
          "expr": "(sum(sum_over_time(ai_cost_usd_per_minute{billing!=\"subscription\"}[1h])) or vector(0)) * 24"
        }
      ]
    },
    {
      "title": "Subscriptions, at API prices",
      "type": "stat",
      "w": 3,
      "h": 2,
      "unit": "",
      "queries": [
        {
          "expr": "sum(sum_over_time(ai_cost_usd_per_minute{billing=\"subscription\"}[$__range])) or vector(0)"
        }
      ]
    },
    {
      "title": "Models and GPUs without a price",
      "type": "stat",
      "w": 3,
      "h": 2,
      "unit": "",
      "warn": 1,
      "queries": [
        {
          "expr": "(count(count by (model) (genai_tokens_total) unless on (model) genai_token_price) or vector(0)) + (count(count by (model) (gpu_info) unless on (model) gpu_hour_price) or vector(0))"
        }
      ]
    },
    {
      "title": "All AI: cost per hour, by source (USD)",
      "type": "timeseries",
      "w": 12,
      "h": 3,
      "unit": "",
      "min": 0,
      "fill": true,
      "queries": [
        {
          "expr": "sum by (source, billing) (sum_over_time(ai_cost_usd_per_minute[15m])) * 4",
          "legend": "{{source}} ({{billing}})"
        }
      ]
    },
    {
      "title": "All AI: by who spent it, in the shown time (USD)",
      "type": "table",
      "w": 6,
      "h": 4,
      "unit": "",
      "columns": [
        "owner",
        "source",
        "tool",
        "billing"
      ],
      "queries": [
        {
          "expr": "sort_desc(sum by (owner, source, tool, billing) (sum_over_time(ai_cost_usd_per_minute{}[$__range])))",
          "legend": "USD"
        }
      ]
    },
    {
      "title": "All AI: by model, in the shown time (USD)",
      "type": "table",
      "w": 6,
      "h": 4,
      "unit": "",
      "columns": [
        "model",
        "source",
        "billing"
      ],
      "queries": [
        {
          "expr": "sort_desc(sum by (model, source, billing) (sum_over_time(ai_cost_usd_per_minute{}[$__range])))",
          "legend": "USD"
        }
      ]
    },
    {
      "title": "Applications: token cost in the shown time",
      "type": "stat",
      "w": 3,
      "h": 2,
      "unit": "",
      "queries": [
        {
          "expr": "sum(increase(genai_tokens_total{service=~\"$service\"}[$__range]) * on (model, type) group_left genai_token_price)"
        }
      ]
    },
    {
      "title": "Applications: at this rate, per day",
      "type": "stat",
      "w": 3,
      "h": 2,
      "unit": "",
      "queries": [
        {
          "expr": "sum(rate(genai_tokens_total{service=~\"$service\"}[1h]) * on (model, type) group_left genai_token_price) * 86400"
        }
      ]
    },
    {
      "title": "Applications: model calls in the shown time",
      "type": "stat",
      "w": 3,
      "h": 2,
      "unit": "",
      "queries": [
        {
          "expr": "sum(increase(genai_requests_total{service=~\"$service\"}[$__range]))"
        }
      ]
    },
    {
      "title": "Applications: cost per call",
      "type": "stat",
      "w": 3,
      "h": 2,
      "unit": "",
      "queries": [
        {
          "expr": "sum(increase(genai_tokens_total{service=~\"$service\"}[$__range]) * on (model, type) group_left genai_token_price) / sum(increase(genai_requests_total{service=~\"$service\"}[$__range]))"
        }
      ]
    },
    {
      "title": "Applications: cost per hour, by model",
      "type": "timeseries",
      "w": 6,
      "h": 3,
      "unit": "",
      "min": 0,
      "queries": [
        {
          "expr": "sum by (model) (rate(genai_tokens_total{service=~\"$service\"}[15m]) * on (model, type) group_left genai_token_price) * 3600",
          "legend": "{{model}}"
        }
      ],
      "fill": true
    },
    {
      "title": "Applications: tokens per minute, by kind",
      "type": "timeseries",
      "w": 6,
      "h": 3,
      "unit": "",
      "min": 0,
      "queries": [
        {
          "expr": "sum by (type) (rate(genai_tokens_total{service=~\"$service\"}[5m])) * 60",
          "legend": "{{type}}"
        }
      ]
    },
    {
      "title": "Applications: cost by service, in the shown time",
      "type": "table",
      "w": 6,
      "h": 4,
      "unit": "",
      "queries": [
        {
          "expr": "sort_desc(sum by (service) (increase(genai_tokens_total{service=~\"$service\"}[$__range]) * on (model, type) group_left genai_token_price))",
          "legend": "{{service}}"
        }
      ]
    },
    {
      "title": "Applications: cost by model, in the shown time",
      "type": "table",
      "w": 6,
      "h": 4,
      "unit": "",
      "queries": [
        {
          "expr": "sort_desc(sum by (provider, model) (increase(genai_tokens_total{service=~\"$service\"}[$__range]) * on (model, type) group_left genai_token_price))",
          "legend": "{{provider}} {{model}}"
        }
      ]
    },
    {
      "title": "Applications: calls per minute, by model",
      "type": "timeseries",
      "w": 6,
      "h": 3,
      "unit": "",
      "min": 0,
      "queries": [
        {
          "expr": "sum by (model) (rate(genai_requests_total{service=~\"$service\"}[5m])) * 60",
          "legend": "{{model}}"
        }
      ]
    },
    {
      "title": "Applications: average seconds per call, by model",
      "type": "timeseries",
      "w": 6,
      "h": 3,
      "unit": "seconds",
      "min": 0,
      "queries": [
        {
          "expr": "sum by (model) (rate(genai_request_duration_seconds_sum{service=~\"$service\"}[5m])) / sum by (model) (rate(genai_request_duration_seconds_count{service=~\"$service\"}[5m]))",
          "legend": "{{model}}"
        }
      ]
    },
    {
      "title": "Applications: tokens per call, by service and model",
      "type": "table",
      "w": 6,
      "h": 4,
      "unit": "",
      "queries": [
        {
          "expr": "sort_desc(sum by (service, model) (increase(genai_tokens_total{service=~\"$service\"}[$__range])) / sum by (service, model) (increase(genai_requests_total{service=~\"$service\"}[$__range])))",
          "legend": "{{service}} {{model}}"
        }
      ]
    },
    {
      "title": "Applications: models in use WITHOUT a price",
      "type": "table",
      "w": 6,
      "h": 4,
      "unit": "",
      "queries": [
        {
          "expr": "count by (provider, model) (genai_tokens_total{service=~\"$service\"}) unless on (model) genai_token_price",
          "legend": "{{provider}} {{model}}"
        }
      ]
    },
    {
      "title": "GPU cost per hour, all GPUs",
      "type": "stat",
      "w": 3,
      "h": 2,
      "unit": "",
      "queries": [
        {
          "expr": "sum(gpu_info * on (model) group_left gpu_hour_price)"
        }
      ]
    },
    {
      "title": "GPU cost in the shown time",
      "type": "stat",
      "w": 3,
      "h": 2,
      "unit": "",
      "queries": [
        {
          "expr": "sum(avg_over_time(gpu_info[$__range]) * on (model) group_left gpu_hour_price) * $__range_s / 3600"
        }
      ]
    },
    {
      "title": "GPU cost spent on idle time",
      "type": "stat",
      "w": 3,
      "h": 2,
      "unit": "",
      "queries": [
        {
          "expr": "sum((1 - avg_over_time(gpu_utilization_ratio[$__range])) * on (agent, gpu) group_left (model) gpu_info * on (model) group_left gpu_hour_price) * $__range_s / 3600"
        }
      ],
      "warn": 1
    },
    {
      "title": "GPU hours used, of hours paid for",
      "type": "stat",
      "w": 3,
      "h": 2,
      "unit": "ratio",
      "queries": [
        {
          "expr": "avg(avg_over_time(gpu_utilization_ratio[$__range]))"
        }
      ]
    },
    {
      "title": "Idle GPU cost in the shown time, by GPU",
      "type": "table",
      "w": 6,
      "h": 4,
      "unit": "",
      "queries": [
        {
          "expr": "sort_desc((1 - avg_over_time(gpu_utilization_ratio[$__range])) * on (agent, gpu) group_left (model) gpu_info * on (model) group_left gpu_hour_price * $__range_s / 3600)",
          "legend": "{{agent}} gpu {{gpu}} ({{model}})"
        }
      ]
    },
    {
      "title": "GPU models WITHOUT a price",
      "type": "table",
      "w": 6,
      "h": 4,
      "unit": "",
      "queries": [
        {
          "expr": "count by (model) (gpu_info) unless on (model) gpu_hour_price",
          "legend": "{{model}}"
        }
      ]
    }
  ]
}
